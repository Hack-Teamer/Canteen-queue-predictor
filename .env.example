# QueueSense Environment Variables

# App
PROJECT_NAME="QueueSense"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=queuesense
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/queuesense

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & JWT
SECRET_KEY=supersecretjwtkeyforqueuesensecanteeenwaittime2024!#$%
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vision Service
VISION_API_KEY=vision-secret-api-key-2024
CROWD_STALE_SECONDS=30

# CORS
BACKEND_CORS_ORIGINS=["*"]

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=15
RATE_LIMIT_ORDER_PER_MINUTE=30

# ML & Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_REGISTRY_PATH=ml_models
MIN_RETRAIN_ROWS=500
